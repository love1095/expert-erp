# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.

# Signing key for login tokens: base64, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
# Keep it stable — changing it logs every user out. Use a different value per environment.
APP_JWT_SECRET=

# Encrypts integration secrets stored in the database (Shopify client secret and access tokens):
# base64, exactly 32 bytes. Generate one with:
#   openssl rand -base64 32
# Keep it stable — changing it makes saved integration secrets unreadable (they must be re-entered).
APP_ENCRYPTION_KEY=

# Password of the platform's super admin ("admin"), made on the first start when there is none. It belongs to
# no organisation and gives organisations their plans (Platform -> Organisations). Unset: a random one is logged once.
APP_SUPERADMIN_PASSWORD=

# Shopify background work (webhook retries, the daily check, stock sent to Shopify every 20 s and every night).
# Set false on a development machine connected to a real store, so nothing is sent to it unless asked on the page.
APP_SHOPIFY_SCHEDULER_ENABLED=true

# Xero API link. fake (the default): a stand-in answers like Xero, nothing leaves the server.
# live: make a "Web app" at https://developer.xero.com/app/manage with the redirect URI below, then fill these in
# (or leave the three empty and enter them as the super admin on Platform -> Integration apps; the page wins over these).
# On a development machine connect only the Xero Demo Company, never a real organisation.
APP_XERO_MODE=fake
APP_XERO_CLIENT_ID=
APP_XERO_CLIENT_SECRET=
# Must be exactly the redirect URI typed in the Xero app (development: http://localhost:3000/settings/integrations/xero/callback)
APP_XERO_REDIRECT_URI=
# Optional: the webhook signing key (needs a public https address); without it payments are polled every 5 minutes
APP_XERO_WEBHOOK_KEY=

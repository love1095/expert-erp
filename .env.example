# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.

# Signing key for login tokens: base64, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
# Keep it stable — changing it logs every user out. Use a different value per environment.
APP_JWT_SECRET=

# Encrypts integration secrets stored in the database (Shopify client secret and access tokens):
# base64, exactly 32 bytes. Generate one with:
#   openssl rand -base64 32
# Keep it stable — changing it makes saved integration secrets unreadable (they must be re-entered).
APP_ENCRYPTION_KEY=

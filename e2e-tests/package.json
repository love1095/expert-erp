{
  "name": "expert-erp-e2e",
  "private": true,
  "description": "Browser and API end-to-end tests for Expert ERP (Playwright)",
  "scripts": {
    "test": "playwright test",
    "test:p0": "playwright test --grep @P0",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "catalog": "playwright test --list --reporter=json > test-catalog.json",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
